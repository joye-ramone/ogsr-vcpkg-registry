diff --git a/src/d3d11/d3d11-graphics.cpp b/src/d3d11/d3d11-graphics.cpp
index 5d9b95a..560703c 100644
--- a/src/d3d11/d3d11-graphics.cpp
+++ b/src/d3d11/d3d11-graphics.cpp
@@ -104,6 +104,56 @@ namespace nvrhi::d3d11
         return GraphicsPipelineHandle::Create(pso);
     }
 
+    GraphicsPipelineHandle createGraphicsPipelineForNative(const GraphicsPipelineDesc& desc, const FramebufferInfo& fbinfo, const D3D11_PRIMITIVE_TOPOLOGY topology, ID3D11RasterizerState* rs,
+        ID3D11BlendState* bs, ID3D11DepthStencilState* dss)
+    {
+        if (!rs || !bs || !dss)
+            return nullptr;
+
+        GraphicsPipeline *pso = new GraphicsPipeline();
+        pso->desc = desc;
+        pso->framebufferInfo = fbinfo;
+        pso->primitiveTopology = topology;
+        pso->inputLayout = checked_cast<InputLayout*>(desc.inputLayout.Get());
+
+        pso->nativeRS = rs;
+        pso->nativeBlendState = bs;
+        pso->nativeDepthStencilState = dss;
+        pso->pRS = rs;
+        pso->pBlendState = bs;
+        pso->pDepthStencilState = dss;
+
+        // the blend factor is applied with the pipeline and, when a target blends with it, whenever it changes
+        D3D11_BLEND_DESC blend{};
+        bs->GetDesc(&blend);
+        const auto usesFactor = [](const D3D11_BLEND b) { return b == D3D11_BLEND_BLEND_FACTOR || b == D3D11_BLEND_INV_BLEND_FACTOR; };
+        for (uint32_t i = 0; i < (blend.IndependentBlendEnable ? c_MaxRenderTargets : 1u); i++)
+        {
+            const D3D11_RENDER_TARGET_BLEND_DESC& t = blend.RenderTarget[i];
+            if (t.BlendEnable && (usesFactor(t.SrcBlend) || usesFactor(t.DestBlend) || usesFactor(t.SrcBlendAlpha) || usesFactor(t.DestBlendAlpha)))
+                pso->requiresBlendFactor = true;
+        }
+
+        pso->shaderMask = ShaderType::None;
+        if (desc.VS) { pso->pVS = checked_cast<Shader*>(desc.VS.Get())->VS; pso->shaderMask = pso->shaderMask | ShaderType::Vertex; }
+        if (desc.HS) { pso->pHS = checked_cast<Shader*>(desc.HS.Get())->HS; pso->shaderMask = pso->shaderMask | ShaderType::Hull; }
+        if (desc.DS) { pso->pDS = checked_cast<Shader*>(desc.DS.Get())->DS; pso->shaderMask = pso->shaderMask | ShaderType::Domain; }
+        if (desc.GS) { pso->pGS = checked_cast<Shader*>(desc.GS.Get())->GS; pso->shaderMask = pso->shaderMask | ShaderType::Geometry; }
+        if (desc.PS) { pso->pPS = checked_cast<Shader*>(desc.PS.Get())->PS; pso->shaderMask = pso->shaderMask | ShaderType::Pixel; }
+
+        for (auto& _layout : desc.bindingLayouts)
+        {
+            BindingLayout* layout = checked_cast<BindingLayout*>(_layout.Get());
+            if ((layout->desc.visibility & ShaderType::Pixel) == 0)
+                continue;
+            for (const auto& item : layout->desc.bindings)
+                if (item.type == ResourceType::TypedBuffer_UAV || item.type == ResourceType::Texture_UAV || item.type == ResourceType::StructuredBuffer_UAV)
+                    pso->pixelShaderHasUAVs = true;
+        }
+
+        return GraphicsPipelineHandle::Create(pso);
+    }
