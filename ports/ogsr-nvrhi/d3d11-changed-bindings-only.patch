+
+    // the slots in [minSlot, maxSlot] whose bound object differs; false when none
+    template <class T>
+    bool changedSlots(const T* bound, const T* next, uint32_t minSlot, uint32_t maxSlot, uint32_t& first, uint32_t& last)
+    {
+        first = UINT32_MAX;
+        last = 0;
+        for (uint32_t i = minSlot; i <= maxSlot; i++)
+        {
+            if (bound[i] != next[i])
+            {
+                first = std::min(first, i);
+                last = i;
+            }
+        }
+        return first != UINT32_MAX;
+    }
+}
+
+void CommandList::bindStageConstantBuffers(uint32_t stage, uint32_t minSlot, uint32_t maxSlot, ID3D11Buffer* const* buffers, const UINT* offsets, const UINT* counts) const
+{
+    BoundStage& bound = m_BoundStages[stage];
+    const bool ranges = offsets && m_D3DContext1;
+    uint32_t first = UINT32_MAX;
+    uint32_t last = 0;
+    for (uint32_t i = minSlot; i <= maxSlot; i++)
+    {
+        const UINT offset = ranges ? offsets[i] : 0;
+        const UINT count = ranges ? counts[i] : 0;
+        if (bound.constantBuffers[i] != buffers[i] || bound.constantBufferOffsets[i] != offset || bound.constantBufferCounts[i] != count)
+        {
+            first = std::min(first, i);
+            last = i;
+        }
+    }
+    if (first == UINT32_MAX)
+        return;
+
+    if (ranges)
+        (m_D3DContext1.Get()->*c_SetConstantBuffers1[stage])(first, last - first + 1, buffers + first, offsets + first, counts + first);
+    else
+        (m_D3DContext.Get()->*c_SetConstantBuffers[stage])(first, last - first + 1, buffers + first);
+    for (uint32_t i = first; i <= last; i++)
+    {
+        bound.constantBuffers[i] = buffers[i];
+        bound.constantBufferOffsets[i] = ranges ? offsets[i] : 0;
+        bound.constantBufferCounts[i] = ranges ? counts[i] : 0;
+    }
+}
+
+void CommandList::bindStageShaderResources(uint32_t stage, uint32_t minSlot, uint32_t maxSlot, ID3D11ShaderResourceView* const* views) const
+{
+    BoundStage& bound = m_BoundStages[stage];
+    uint32_t first, last;
+    if (!changedSlots(bound.SRVs, views, minSlot, maxSlot, first, last))
+        return;
+    (m_D3DContext.Get()->*c_SetShaderResources[stage])(first, last - first + 1, views + first);
+    std::copy(views + first, views + last + 1, bound.SRVs + first);
+}
+
+void CommandList::bindStageSamplers(uint32_t stage, uint32_t minSlot, uint32_t maxSlot, ID3D11SamplerState* const* samplers) const
+{
+    BoundStage& bound = m_BoundStages[stage];
+    uint32_t first, last;
+    if (!changedSlots(bound.samplers, samplers, minSlot, maxSlot, first, last))
+        return;
+    (m_D3DContext.Get()->*c_SetSamplers[stage])(first, last - first + 1, samplers + first);
+    std::copy(samplers + first, samplers + last + 1, bound.samplers + first);
+}
+
+void CommandList::bindStageSet(uint32_t stage, const BindingSet* set) const
+{
+    const bool whole = set->wholeConstantBuffers;
+    bindStageConstantBuffers(stage, set->minConstantBufferSlot, set->maxConstantBufferSlot, set->constantBuffers, whole ? nullptr : set->constantBufferOffsets, whole ? nullptr : set->constantBufferCounts);
+    bindStageShaderResources(stage, set->minSRVSlot, set->maxSRVSlot, set->SRVs);
+    bindStageSamplers(stage, set->minSamplerSlot, set->maxSamplerSlot, set->samplers);
+}
