diff --git a/src/d3d11/d3d11-shader.cpp b/src/d3d11/d3d11-shader.cpp
index 4432c0f..74c9ddc 100644
--- a/src/d3d11/d3d11-shader.cpp
+++ b/src/d3d11/d3d11-shader.cpp
@@ -374,4 +374,39 @@ namespace nvrhi::d3d11
         return InputLayoutHandle::Create(inputLayout);
     }
 
+    ShaderHandle createShaderHandleForNative(const ShaderDesc& desc, ID3D11DeviceChild* native, const void* bytecode, const size_t bytecodeSize)
+    {
+        if (!native)
+            return nullptr;
+
+        RefCountPtr<Shader> shader = RefCountPtr<Shader>::Create(new Shader());
+        shader->desc = desc;
+        switch (desc.shaderType)  // NOLINT(clang-diagnostic-switch-enum)
+        {
+        case ShaderType::Vertex: shader->VS = static_cast<ID3D11VertexShader*>(native); break;
+        case ShaderType::Hull: shader->HS = static_cast<ID3D11HullShader*>(native); break;
+        case ShaderType::Domain: shader->DS = static_cast<ID3D11DomainShader*>(native); break;
+        case ShaderType::Geometry: shader->GS = static_cast<ID3D11GeometryShader*>(native); break;
+        case ShaderType::Pixel: shader->PS = static_cast<ID3D11PixelShader*>(native); break;
+        case ShaderType::Compute: shader->CS = static_cast<ID3D11ComputeShader*>(native); break;
+        default: return nullptr;
+        }
+        if (bytecode && bytecodeSize)
+            shader->bytecode.assign(static_cast<const char*>(bytecode), static_cast<const char*>(bytecode) + bytecodeSize);
+        return shader;
+    }
+
+    InputLayoutHandle createInputLayoutHandleForNative(ID3D11InputLayout* native, const VertexAttributeDesc* attributes, const uint32_t attributeCount)
+    {
+        if (!native)
+            return nullptr;
+
+        InputLayout* inputLayout = new InputLayout();
+        inputLayout->layout = native;
+        inputLayout->attributes.assign(attributes, attributes + attributeCount);
+        for (uint32_t i = 0; i < attributeCount; i++)
+            inputLayout->elementStrides.emplace(attributes[i].bufferIndex, attributes[i].elementStride);
+        return InputLayoutHandle::Create(inputLayout);
+    }
+
 } // nanmespace nvrhi::d3d11
