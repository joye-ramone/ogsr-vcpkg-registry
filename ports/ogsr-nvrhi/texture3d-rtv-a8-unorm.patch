diff --git a/src/d3d12/d3d12-texture.cpp b/src/d3d12/d3d12-texture.cpp
index d9ae56e..63b595c 100644
--- a/src/d3d12/d3d12-texture.cpp
+++ b/src/d3d12/d3d12-texture.cpp
@@ -785,7 +785,15 @@ namespace nvrhi::d3d12
 
     void Texture::createRTV(size_t descriptor, Format format, TextureSubresourceSet subresources) const
     {
+        const TextureSubresourceSet requested = subresources;
         subresources = subresources.resolve(desc, true);
+        if (desc.dimension == TextureDimension::Texture3D)
+        {
+            // a 3D target's array slices are its W slices (resolve keeps one; state tracking still sees the one subresource of the mip)
+            const ArraySlice depth = std::max(desc.depth >> subresources.baseMipLevel, 1u);
+            subresources.baseArraySlice = std::min(requested.baseArraySlice, depth - 1);
+            subresources.numArraySlices = std::min(requested.numArraySlices, depth - subresources.baseArraySlice);
+        }
 
         D3D12_RENDER_TARGET_VIEW_DESC viewDesc = {};
 
