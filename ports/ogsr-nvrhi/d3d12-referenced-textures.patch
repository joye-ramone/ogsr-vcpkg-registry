+    void getReferencedTextures(nvrhi::ICommandList* commandList, ITexture* const** textures, size_t* count)
+    {
+        auto* list = static_cast<CommandList*>(commandList->getNativeObject(ObjectTypes::Nvrhi_D3D12_CommandList).pointer);
+        const std::vector<ITexture*>* referenced = list ? list->getReferencedTextures() : nullptr;
