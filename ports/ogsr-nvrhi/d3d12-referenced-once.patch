+    // The resources a command list instance references, by address (OGSR): a list binds the same pipelines, buffers and framebuffers again and
+    // again, and each push into referencedResources is an interlocked AddRef on an object other recording threads use too. Open addressing,
+    // power of two, at most half full; a referenced resource cannot be freed and its address reused while the instance holds it
+    class ReferenceSet
+    {
+    public:
+        // true: not referenced yet, now recorded
+        bool insert(const void* resource)
+        {
+            if ((m_Count + 1) * 2 > m_Slots.size())
+                grow();
+            const size_t mask = m_Slots.size() - 1;
+            for (size_t i = slot(resource) & mask;; i = (i + 1) & mask)
+            {
+                if (m_Slots[i] == resource)
+                    return false;
+                if (!m_Slots[i])
+                {
+                    m_Slots[i] = resource;
+                    ++m_Count;
+                    return true;
+                }
+            }
+        }
+
+    private:
+        std::vector<const void*> m_Slots;
+        size_t m_Count = 0;
+
+        static size_t slot(const void* resource) { return size_t((uint64_t(reinterpret_cast<uintptr_t>(resource) >> 4) * 0x9E3779B97F4A7C15ull) >> 32); }
+
+        void grow()
+        {
+            std::vector<const void*> old = std::move(m_Slots);
+            m_Slots.assign(old.empty() ? 256 : old.size() * 2, nullptr);
+            m_Count = 0;
+            for (const void* resource : old)
+                if (resource)
+                    insert(resource);
+        }
+    };
+
     class CommandListInstance
     {
     public:
+        // referencedResources.push_back(resource) for a resource not referenced yet (OGSR)
+        void reference(IResource* resource)
+        {
+            if (resource && referencedSet.insert(resource))
+                referencedResources.push_back(resource);
+        }
+
+        ReferenceSet referencedSet;
         uint64_t submittedInstance = 0;
         CommandQueue commandQueue = CommandQueue::Graphics;
         RefCountPtr<ID3D12Fence> fence;
