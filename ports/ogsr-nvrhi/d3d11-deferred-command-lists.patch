+    uint64_t Device::executeCommandLists(ICommandList* const* pCommandLists, size_t numCommandLists, CommandQueue executionQueue)
+    {
+        (void)executionQueue;
+
+        // the immediate list ran while it recorded; a deferred list runs its FinishCommandList result here, in the given order
+        bool executed = false;
+        for (size_t i = 0; i < numCommandLists; i++)
+        {
+            CommandList* commandList = checked_cast<CommandList*>(pCommandLists[i]);
+            if (commandList->isImmediate())
+                continue;
+
+            RefCountPtr<ID3D11CommandList> commands = commandList->takeRecordedCommands();
+            if (!commands)
+                continue;
+
+            m_Context.immediateContext->ExecuteCommandList(commands, FALSE);
+            executed = true;
+        }
+
+        // ExecuteCommandList(FALSE) leaves the immediate context in its default state
+        if (executed)
+            checked_cast<CommandList*>(m_ImmediateCommandList.Get())->resetStateCache();
+
+        return 0;
     }
 
