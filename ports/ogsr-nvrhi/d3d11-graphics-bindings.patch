+bool CommandList::setGraphicsBindings(const StageBindings* stages, uint32_t stageMask)
+{
+    if (m_CurrentComputeStateValid)
+        return false;
+
+    for (uint32_t stage = 0; stage < std::size(c_GraphicsStages); stage++)
+    {
+        if ((stageMask & (1u << stage)) == 0)
+            continue;
+        const StageBindings& b = stages[stage];
+        const uint32_t cbEnd = std::min(b.constantBufferEnd, uint32_t(D3D11_COMMONSHADER_CONSTANT_BUFFER_API_SLOT_COUNT));
+        const uint32_t srvEnd = std::min(b.shaderResourceEnd, uint32_t(D3D11_COMMONSHADER_INPUT_RESOURCE_SLOT_COUNT));
+        const uint32_t samplerEnd = std::min(b.samplerEnd, uint32_t(D3D11_COMMONSHADER_SAMPLER_SLOT_COUNT));
+        if (b.constantBufferBegin < cbEnd)
+            bindStageConstantBuffers(stage, b.constantBufferBegin, cbEnd - 1, b.constantBuffers, nullptr, nullptr);
+        if (b.shaderResourceBegin < srvEnd)
+            bindStageShaderResources(stage, b.shaderResourceBegin, srvEnd - 1, b.shaderResources);
+        if (b.samplerBegin < samplerEnd)
+            bindStageSamplers(stage, b.samplerBegin, samplerEnd - 1, b.samplers);
+    }
+    return true;
+}
+
 #define D3D11_SET_ARRAY(method, min, max, array) \
         if ((max) >= (min)) \
             m_D3DContext->method(min, ((max) - (min) + 1), &(array)[min])
