+    // One graphics stage's constant buffers (bound whole), views and samplers from the caller's arrays, indexed by slot; [begin, end) of each
+    // kind is bound (begin == end: none)
+    struct StageBindings
+    {
+        ID3D11Buffer* const* constantBuffers = nullptr;
+        ID3D11ShaderResourceView* const* shaderResources = nullptr;
+        ID3D11SamplerState* const* samplers = nullptr;
+        uint32_t constantBufferBegin = 0;
+        uint32_t constantBufferEnd = 0;
+        uint32_t shaderResourceBegin = 0;
+        uint32_t shaderResourceEnd = 0;
+        uint32_t samplerBegin = 0;
+        uint32_t samplerEnd = 0;
+    };
+
+    // Binding without binding sets, for pipelines made without binding layouts (setGraphicsState then binds no sets): the stages in stageMask
+    // (bits in stages[] order: VS, HS, DS, GS, PS) bind the slots that differ from what the list has bound, and the list records them as it does
+    // for sets, so later calls and setGraphicsState see them. Call after setGraphicsState (a switch from compute clears the context). False,
+    // nothing done: the list is in compute state
+    NVRHI_API bool setGraphicsBindings(ICommandList* commandList, const StageBindings* stages, uint32_t stageMask);
+
+    // True while the list holds the graphics state of its last setGraphicsState (no reset, clear or compute state since): a draw that changes
+    // nothing of it can follow without any state call
+    NVRHI_API bool hasGraphicsState(ICommandList* commandList);
+
     // The vertex and index buffers of the next draw when nothing else of the graphics state changed since the last setGraphicsState: binds what
