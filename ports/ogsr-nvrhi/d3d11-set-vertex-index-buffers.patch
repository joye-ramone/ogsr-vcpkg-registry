+    bool CommandList::setVertexIndexBuffers(const VertexBufferBinding* vertexBuffers, uint32_t vertexBufferCount, ID3D11Buffer* const* vertexBufferResources,
+        const IndexBufferBinding& indexBuffer, ID3D11Buffer* indexBufferResource)
+    {
+        if (!m_CurrentGraphicsStateValid || m_CurrentComputeStateValid || vertexBufferCount > c_MaxVertexAttributes)
+            return false;
+
+        // as setGraphicsState's vertex / index buffer part, with the D3D11 resources given
+        bool updateVertexBuffers = vertexBufferCount != m_CurrentVertexBufferBindings.size();
+        for (uint32_t i = 0; i < vertexBufferCount && !updateVertexBuffers; i++)
+        {
+            const VertexBufferBinding& binding = vertexBuffers[i];
+            updateVertexBuffers = binding.slot >= c_MaxVertexAttributes || binding != m_CurrentVertexBufferBindings[i] ||
+                m_CurrentVertexBufferResources[binding.slot] != vertexBufferResources[i];
+        }
+        if (updateVertexBuffers)
+        {
+            ID3D11Buffer* pVertexBuffers[c_MaxVertexAttributes] = {};
+            UINT pVertexBufferStrides[c_MaxVertexAttributes] = {};
+            UINT pVertexBufferOffsets[c_MaxVertexAttributes] = {};
+            uint32_t maxVbIndex = 0;
+
+            const InputLayout* inputLayout = checked_cast<GraphicsPipeline*>(m_CurrentGraphicsPipeline.Get())->inputLayout;
+            for (uint32_t i = 0; i < vertexBufferCount; i++)
+            {
+                const VertexBufferBinding& binding = vertexBuffers[i];
+                if (binding.slot >= c_MaxVertexAttributes)
+                    continue;
+
+                pVertexBuffers[binding.slot] = vertexBufferResources[i];
+                if (binding.stride)
+                    pVertexBufferStrides[binding.slot] = binding.stride;
+                else if (inputLayout)
+                {
+                    const auto stride = inputLayout->elementStrides.find(binding.slot);
+                    pVertexBufferStrides[binding.slot] = stride != inputLayout->elementStrides.end() ? stride->second : 0;
+                }
+                pVertexBufferOffsets[binding.slot] = UINT(binding.offset);
+                maxVbIndex = std::max(maxVbIndex, binding.slot);
+            }
+            for (const VertexBufferBinding& binding : m_CurrentVertexBufferBindings)
+            {
+                if (binding.slot < c_MaxVertexAttributes)
+                    maxVbIndex = std::max(maxVbIndex, binding.slot);
+            }
+
+            m_D3DContext->IASetVertexBuffers(0, maxVbIndex + 1, pVertexBuffers, pVertexBufferStrides, pVertexBufferOffsets);
+
+            m_CurrentVertexBufferBindings.resize(vertexBufferCount);
+            std::fill(std::begin(m_CurrentVertexBufferResources), std::end(m_CurrentVertexBufferResources), nullptr);
+            for (uint32_t i = 0; i < vertexBufferCount; i++)
+            {
+                m_CurrentVertexBufferBindings[i] = vertexBuffers[i];
+                if (vertexBuffers[i].slot < c_MaxVertexAttributes)
+                    m_CurrentVertexBufferResources[vertexBuffers[i].slot] = vertexBufferResources[i];
+            }
+        }
+
+        if (m_CurrentIndexBufferBinding != indexBuffer || m_CurrentIndexBufferResource != indexBufferResource)
+        {
+            if (indexBuffer.buffer)
+                m_D3DContext->IASetIndexBuffer(indexBufferResource, getDxgiFormatMapping(indexBuffer.format).srvFormat, indexBuffer.offset);
+            else
+                m_D3DContext->IASetIndexBuffer(nullptr, DXGI_FORMAT_UNKNOWN, 0);
+            m_CurrentIndexBufferBinding = indexBuffer;
+            m_CurrentIndexBufferResource = indexBufferResource;
+        }
+        return true;
+    }
